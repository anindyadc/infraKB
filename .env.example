# ── DATABASE ──────────────────────────────────
DATABASE_URL="mysql://infrakb:secret@localhost:3306/infrakb"

# ── AUTH ──────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── SERVER ────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL="http://localhost:5173"   # CORS origin

# ── UPLOADS ───────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
# Optional S3 (leave empty to use local disk)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""

# ── RATE LIMITING ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000    # 15 min
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_MAX=10

# ── LOGGING ───────────────────────────────────
LOG_LEVEL=info    # trace | debug | info | warn | error
